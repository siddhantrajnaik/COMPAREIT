# Copy to .env and edit. `npm run keys` fills in the VAPID values for you.

PORT=5177
HOST=0.0.0.0

# Your delivery point. This decides which dark store serves you and therefore
# every price you see. Also editable live in the app under Settings.
#
# Both forms matter: Blinkit/Zepto resolve a dark store from LAT/LON, while
# Flipkart, DMart and JioMart return no catalogue at all without a PINCODE.
LAT=12.9716
LON=77.5946
LOCALITY=Bengaluru
PINCODE=560001

# Which platforms to query. `jiomart` is omitted on purpose — it gates hard on
# pincode and resists automation; add it here if it works on your connection.
PLATFORMS=blinkit,zepto,instamart,bigbasket,dmart,flipkart

# false = watch the scraper work in a visible window. Useful when a platform
# starts misbehaving and you want to see what it's actually serving.
HEADLESS=true

# Background re-pricing of tracked items.
POLL_INTERVAL_MS=900000
SCRAPE_DELAY_MS=1500
SEARCH_CACHE_MS=300000

# Zomato Food Rescue radar. Needs `npm run login` first.
RESCUE_ENABLED=false
RESCUE_INTERVAL_MS=60000

# Filled in by `npm run keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Docker deployment only (see DEPLOY.md) -------------------------------
# Push notifications need a valid certificate, which needs a real hostname —
# a bare IP won't do. DuckDNS gives you one free.
DOMAIN=
TLS_EMAIL=
